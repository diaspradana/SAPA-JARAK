# ==========================================
# SAPA-JARAK Docker Deployment Configuration
# ==========================================

# Application Settings
APP_NAME=SAPA-JARAK
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_PORT=8000

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

# ------------------------------------------
# Database Configuration (MySQL Default)
# ------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sapa_jarak
DB_USERNAME=sapa_user
DB_PASSWORD=sapa_secret
DB_ROOT_PASSWORD=root_secret
FORWARD_DB_PORT=3306

# ------------------------------------------
# Alternative: SQLite Configuration
# (Uncomment below to use SQLite instead of MySQL)
# ------------------------------------------
# DB_CONNECTION=sqlite
# DB_DATABASE=database/sqlite/database.sqlite

# ------------------------------------------
# Startup Automation
# ------------------------------------------
AUTORUN_MIGRATIONS=true
AUTORUN_SEED=true
OPTIMIZE_LARAVEL=false

# ------------------------------------------
# Optional phpMyAdmin (Profile: tools)
# Run with: docker compose --profile tools up -d
# ------------------------------------------
PMA_PORT=8081

# ------------------------------------------
# WhatsApp Notification Gateway Simulation
# ------------------------------------------
WHATSAPP_GATEWAY_URL=https://api.fonnte.com/send
WHATSAPP_API_TOKEN=mock_token_sapa_jarak_2026
WHATSAPP_SIMULATION_MODE=true

# ------------------------------------------
# AI Decision Support Assistant (FastAPI)
# ------------------------------------------
ML_SERVICE_URL=http://ai_assistant:8001
ML_PORT=8001
